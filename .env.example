# כתובת קנונית, Open Graph, sitemap ו־robots (ללא סלאש בסוף). שמרו עקביות www/ללא-www עם ההפניות בשרת
VITE_SITE_URL=https://sabglass.co.il

# טלפון ל־JSON-LD (פורמט בינלאומי, לדוגמה +972-53-530-6456)
VITE_BUSINESS_PHONE=+972-53-530-6456

# אינסטגרם אמיתי ל־JSON-LD (sameAs). ריק או placeholder (yourpage) = השדה לא ייכנס ל־JSON-LD
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/sabglass

# Google Search Console — תג האימות מוטמע ב־index.html (לא דרך env)

# Google Tag Manager — מזהה המיכל (למשל GTM-ABC12345). ריק = ללא סקריפט GTM בבילד
VITE_GTM_CONTAINER_ID=

# Google Analytics 4 — מזהה מדידה (למשל G-XXXXXXXXXX). ריק או לא תקין = ללא gtag בבילד (Looker Studio / ניתוח)
VITE_GA_MEASUREMENT_ID=

